# Application
APP_NAME=KingStop
DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret

# Database (SQLite is the zero-setup default)
DATABASE_URL=sqlite:///./kingstop.db

# Market data
USE_LIVE_MARKET_DATA=false
YAHOO_REFRESH_INTERVAL=60
MARKET_DATA_TIMEOUT_SECONDS=2.5
DEFAULT_TICKERS=["AAPL","MSFT","GOOGL","AMZN","TSLA","NVDA","META","JPM","V","JNJ"]
NSE_TICKERS=["RELIANCE.NS","TCS.NS","HDFCBANK.NS","INFY.NS","ICICIBANK.NS"]
BSE_TICKERS=["RELIANCE.BO","TCS.BO","HDFCBANK.BO","INFY.BO","ICICIBANK.BO"]
CRYPTO_TICKERS=["BTC-USD","ETH-USD","BNB-USD","SOL-USD","XRP-USD","DOGE-USD"]

# Runtime modes and model defaults
APP_MODES=["live","backtesting"]
DEFAULT_MODE=live
DEFAULT_LIVE_MODEL_ID=preloaded_ensemble_v1
DEFAULT_BACKTEST_MODEL_ID=preloaded_ensemble_v1
BACKTEST_DEFAULT_TICKER=AAPL
BACKTEST_DEFAULT_PERIOD=6mo

# Paper-trading seed data. Replace these values on shared deployments.
DEMO_WALLET_NAME=KingStop Demo Wallet
DEMO_WALLET_INITIAL_CASH=100000.0
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-demo-password
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=replace-test-password

# Groq AI chat (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=25.0

# Redis cache (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Stripe billing (optional)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=8000

# Default risk controls
MAX_POSITION_SIZE_PCT=0.02
MAX_PORTFOLIO_RISK_PCT=0.25
STOP_LOSS_PCT=0.05
