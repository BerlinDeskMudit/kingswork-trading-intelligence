# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get webhook secret from https://dashboard.stripe.com/webhooks (add endpoint: /api/v1/payments/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Enable Stripe
STRIPE_ENABLED=true

# Database
DATABASE_URL=sqlite:///./kingstop.db

# App
DEBUG=true
SECRET_KEY=kingstop-super-secret-key-change-in-production

# Optional
# USE_LIVE_MARKET_DATA=false
# REDIS_URL=redis://localhost:6379/0
# USE_REDIS=false
